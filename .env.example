APP_NAME=FichoChat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production / target: PostgreSQL
# Docker local recommandé :
#   docker run --name fichochat-pg -e POSTGRES_PASSWORD=secret -e POSTGRES_USER=fichochat -e POSTGRES_DB=fichochat -p 55432:5432 -d postgres:16
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=fichochat
DB_USERNAME=fichochat
DB_PASSWORD=secret
# Prod Railway : préférer l’URL injectée (ne pas laisser DB_HOST=127.0.0.1)
# DB_URL="${DATABASE_URL}"
# DATABASE_URL=postgresql://user:pass@host:5432/railway

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# En local/prod avec Pusher réel : BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Workers — queues : broadcasts | emails | audits | media | default
# php artisan queue:work --queue=broadcasts,emails,audits,media,default
# Scheduler (cleanup médias) : php artisan schedule:work

# Pusher Channels (Module 9) — passer BROADCAST_CONNECTION=pusher en local/prod
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
# Optionnel (self-host / proxy)
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=brevo
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@fichochat.local"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo (Sendinblue) — API transactionnelle
# Créer une clé : https://app.brevo.com/settings/keys/api
# L'adresse MAIL_FROM_ADDRESS doit être un expéditeur vérifié dans Brevo.
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

AUTH_GUARD=api
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_REFRESH_COOKIE_NAME=fichochat_refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
# AUTH_REFRESH_COOKIE_DOMAIN=
# AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=lax

JWT_SECRET=
# Access token court (minutes) — recommandé 15 pour le Web hybride
JWT_TTL=15
JWT_REFRESH_TTL=20160

FRONTEND_URL=http://localhost:5173
# Origines CORS supplémentaires (séparées par virgule) ; défaut = FRONTEND_URL
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# Emails auto-promus admin au login /me (séparés par virgule)
ADMIN_EMAILS=

# Sécurité HTTP (prod Railway : FORCE_HTTPS=true)
FORCE_HTTPS=false
SECURITY_HEADERS=true
# SECURITY_HSTS_MAX_AGE=31536000
# SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
# SECURITY_HSTS_PRELOAD=false

VITE_APP_NAME="${APP_NAME}"

L5_SWAGGER_GENERATE_ALWAYS=true
# false = chemins relatifs (évite Mixed Content HTTPS derrière un proxy)
L5_SWAGGER_USE_ABSOLUTE_PATH=false
